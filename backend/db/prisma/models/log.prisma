// 操作日志
model serverLog {
  id      Int      @id @default(autoincrement())
  time    DateTime @default(now())
  content String
  type    String

  @@index([time])
  @@index([type])
}

// 登录日志
model loginLog {
  id      Int      @id @default(autoincrement())
  time    DateTime @default(now())
  address String   @default("")
  ip      String   @default("")
  result  Int

  @@index([time])
  @@index([result])
}
